# Server Configuration
APP_ENV=development
APP_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fastix
DB_SSLMODE=disable

# Security & JWT Configuration
JWT_SECRET=replace-with-32-char-random-secret
QR_HMAC_SECRET=replace-with-32-char-hmac-secret
KYB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Payment Gateway (Midtrans)
MIDTRANS_ENV=sandbox
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
