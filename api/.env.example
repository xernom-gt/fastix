# ==============================================================================
# Fastix API — Environment Configuration
# ==============================================================================
# Cara menjalankan dari folder api/:
#   1. Salin file ini menjadi .env
#   2. Jalankan migrasi + server : go run ./cmd/server
#   3. Jalankan migrasi saja     : go run ./cmd/server -migrate-only
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
# Gunakan port 5432 (default PostgreSQL) atau 5433 jika instance lokal memakai port alternatif.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fastix?sslmode=disable

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Origin dev lokal: landing (5173), app wisatawan/mitra/gate (5174), admin (5175)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ------------------------------------------------------------------------------
# Security & Cryptography
# ------------------------------------------------------------------------------
# JWT_SECRET & QR_HMAC_SECRET wajib minimal 16 karakter.
JWT_SECRET=replace-with-32-char-random-secret
QR_HMAC_SECRET=replace-with-32-char-hmac-secret

# Kunci AES-256-GCM (64 karakter hex = 32 byte) untuk enkripsi NIK & NPWP pada KYB.
# Contoh generate: openssl rand -hex 32
KYB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Payment Gateway (Midtrans)
# ------------------------------------------------------------------------------
# MIDTRANS_ENV: sandbox | production
# Boleh dikosongkan saat APP_ENV=development untuk fallback mode simulasi (/simulate-pay).
# Wajib diisi saat APP_ENV=production.
MIDTRANS_ENV=sandbox
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
